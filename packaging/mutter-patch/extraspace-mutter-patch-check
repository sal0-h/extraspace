#!/bin/sh
# Warns when the installed mutter is no longer the one Extraspace's crash patch
# was built against. Run from a pacman hook after any mutter transaction.
#
# Nothing is blocked: upgrades proceed normally, and Extraspace independently
# refuses the scaled path when these two versions disagree, so the worst case is
# a soft-looking tablet display rather than a logout.
set -eu

MARKER="__MARKER__"

installed=$(pacman -Q mutter 2>/dev/null | awk '{print $2}' || true)
patched=$(cat "$MARKER" 2>/dev/null || true)

[ -n "$installed" ] || exit 0
[ "$installed" = "$patched" ] && exit 0

cat >&2 <<EOF

  Mutter is now $installed; Extraspace's recorded patched build is ${patched:-none}.
  Extraspace uses Standard image quality when its compositor check fails.

  To restore Sharper, update the local recipe for this Mutter version and rebuild:
      __BUILD__

  Log out and back in after installation, then restart Extraspace.

EOF
